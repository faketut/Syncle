<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.
  Points to the debug network security config, which permits cleartext HTTP
  to 10.0.2.2 (emulator host) and localhost for local backend development.
  This overlay is merged only for debug builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
