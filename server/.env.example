# Copy to .env (gitignored). For docker-compose dev these defaults match the
# bundled `livekit-server --dev` instance.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
PORT=8787
DB_PATH=./data/syncle.db
TOKEN_TTL_SECONDS=3600
LOG_LEVEL=info
# Per-IP rate limit for POST /v1/sessions. Lower in production if abuse appears.
SESSION_RATE_LIMIT_MAX=30
SESSION_RATE_LIMIT_WINDOW_MS=60000
