root = true

[*.{kt,kts}]
# Compose composables conventionally use PascalCase, which conflicts with
# ktlint's standard:function-naming rule. Disable it project-wide.
ktlint_standard_function-naming = disabled
# Compose, LiveKit, and Material imports rely on grouped wildcard imports
# (e.g. androidx.compose.foundation.layout.*). Allow them.
ktlint_standard_no-wildcard-imports = disabled
# Keep line length lenient — formatters and Compose DSL can produce long
# expressions that are easier to read on one line.
ktlint_standard_max-line-length = disabled
